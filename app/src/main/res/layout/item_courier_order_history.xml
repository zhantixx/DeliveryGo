<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/historyOrderId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tapsyrys #----"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/historyOrderAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jetkızw adresi: "
            android:textColor="@color/black"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/historyOrderAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tólem: 0 tg"
            android:textColor="@color/delivery_green_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/historyOrderStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Märtebe: "
            android:textColor="#757575"
            android:textSize="12sp"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>
