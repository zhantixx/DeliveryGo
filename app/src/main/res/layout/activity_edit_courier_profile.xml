<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f5f5f5">
    <RelativeLayout
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="250dp"
    android:background="@drawable/top_background_login">

    <!-- Кнопка назад -->
    <ImageView
        android:id="@+id/back_button"
        android:layout_width="40dp"
    android:layout_height="40dp"
    android:layout_alignParentStart="true"
    android:layout_alignParentTop="true"
    android:layout_marginStart="16dp"
    android:layout_marginTop="24dp"
    android:src="@drawable/back"
    android:contentDescription="Back"
    app:tint="@android:color/white" />

    <!-- Фото профиля по центру -->
    <ImageView
        android:id="@+id/editImg"
        android:layout_width="90dp"
    android:layout_height="90dp"
    android:layout_centerInParent="true"
    android:src="@drawable/profile"
    android:scaleType="centerCrop"
    android:background="@drawable/white_bg_top_corner"
    android:padding="8dp"
    android:contentDescription="Profile Image"/>

    <TextView
        android:id="@+id/editProfileTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Profildı öñdeu"
        android:textSize="24sp"
        android:textColor="@color/white"
        android:layout_centerHorizontal="true"
        android:layout_below="@+id/editImg"
        android:layout_marginTop="16dp"
        android:textStyle="bold" />

</RelativeLayout>

<ScrollView
android:layout_width="match_parent"
android:layout_height="0dp"
android:layout_weight="1">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Login"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold" />
    <EditText
        android:id="@+id/input_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Login engizińiz"
        android:padding="12dp"
        android:drawableTint="#3A70B4"
        android:drawableStart="@drawable/name"
    android:drawablePadding="12dp"
    android:background="@drawable/text_bg"
    android:layout_marginTop="8dp"
    android:inputType="textPersonName"
    android:textColor="@color/black"
    android:textColorHint="#8e8e8e"
    android:textSize="16sp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Email"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"/>
    <EditText
        android:id="@+id/input_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Email engizińiz"
        android:drawableTint="#3A70B4"
        android:drawableStart="@drawable/email"
    android:drawablePadding="12dp"
    android:inputType="textEmailAddress"
    android:padding="12dp"
    android:background="@drawable/text_bg"
    android:layout_marginTop="8dp"
    android:textColor="@color/black"
    android:textColorHint="#8e8e8e"
    android:textSize="16sp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Telefon nómiri"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"/>
    <EditText
        android:id="@+id/input_phone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Telefon nómiri engizińiz"
        android:drawableStart="@drawable/phone"
    android:drawablePadding="12dp"
    android:inputType="phone"
    android:padding="12dp"
    android:drawableTint="#3A70B4"
    android:background="@drawable/text_bg"
    android:layout_marginTop="8dp"
    android:textColor="@color/black"
    android:textColorHint="#8e8e8e"
    android:textSize="16sp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kólik túri"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"/>
    <EditText
        android:id="@+id/input_vehicle_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Myasaly, car, motorcycle"
        android:padding="12dp"
        android:drawableTint="#3A70B4"
    android:drawablePadding="12dp"
    android:background="@drawable/text_bg"
    android:layout_marginTop="8dp"
    android:inputType="text"
    android:textColor="@color/black"
    android:textColorHint="#8e8e8e"
    android:textSize="16sp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Memlekettik nómir"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"/>
    <EditText
        android:id="@+id/input_license_plate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Memlekettik nómir (bolsa)"
        android:padding="12dp"
        android:drawableTint="#3A70B4"
    android:drawablePadding="12dp"
    android:background="@drawable/text_bg"
    android:layout_marginTop="8dp"
    android:inputType="textCapCharacters"
    android:textColor="@color/black"
    android:textColorHint="#8e8e8e"
    android:textSize="16sp"/>


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Júrgizwşı kýäliginiń nómiri"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"/>
    <EditText
        android:id="@+id/input_driver_license"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Júrgizwşı kýäliginiń nómiri"
        android:padding="12dp"
        android:drawableTint="#3A70B4"
    android:drawablePadding="12dp"
    android:background="@drawable/text_bg"
    android:layout_marginTop="8dp"
    android:inputType="text"
    android:textColor="@color/black"
    android:textColorHint="#8e8e8e"
    android:textSize="16sp"/>

    <!-- Кнопка сохранения -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_update"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Saqtau"
        android:textColor="@android:color/white"
        android:background="@drawable/login_btn_bg"
        app:cornerRadius="8dp"
    android:paddingVertical="12dp"
    android:textSize="18sp"
    android:textStyle="bold"/>
</LinearLayout>
</ScrollView>
    </LinearLayout>
